# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/c4_events"

# BetterAuth
BETTER_AUTH_URL="http://localhost:3000/"
BETTER_AUTH_SECRET="change-me-in-production"

# OIDC Provider
# For development: mock-oauth2-server (docker compose up mock-oauth2)
# For production: Keycloak, Authentik, etc.
BETTER_AUTH_OIDC_CLIENT_ID="c4-events-app"
BETTER_AUTH_OIDC_CLIENT_SECRET="unused-for-mock"
BETTER_AUTH_OIDC_ISSUER="http://localhost:8080/default"
# Optional: redirect URI registered at the IdP, if it is not the default
# <BETTER_AUTH_URL>/api/auth/callback/oidc (e.g. the pre-1.7 path below).
# BETTER_AUTH_OIDC_REDIRECT_URI="http://localhost:3000/api/auth/oauth2/callback/oidc"

# OIDC claim-based permissions
# Prefix for permission claims (e.g., "c4:admin", "c4:space:myspace")
OIDC_CLAIM_PREFIX="c4"
# Scopes to request from OIDC provider (space-separated)
OIDC_SCOPES="openid profile email"
# Claim path(s) to read roles from (comma-separated, dot-notation)
# Examples: "realm_access.roles" (Keycloak), "roles", "groups"
OIDC_ROLES_CLAIM="roles"
# Claim patterns:
#   <prefix>:admin              → sets isAdmin=true
#   <prefix>:space:<slug>       → grants access to space
#   <prefix>:event-type:<slug>  → grants access to event type
#   <prefix>:space:<s>:event-type:<e> → grants access to event type in space
#
# Pre-configured test users (mock-oauth2-server):
#   admin        → c4:admin (full admin access)
#   space-manager → c4:space:demo, c4:space:events
#   event-editor → c4:space:demo:event-type:meetup, c4:event-type:workshop
#   viewer       → no permissions

# Auth configuration (server-only, read at runtime - no rebuild needed)
# Email/password sign-in for admin-created local accounts (Admin -> Users).
AUTH_EMAIL_ENABLED=false
# Allow anyone to register a local account on the login page (needs
# AUTH_EMAIL_ENABLED=true). Never combine with AUTH_ALL_USERS_ADMIN.
AUTH_EMAIL_SIGNUP_ENABLED=false
AUTH_SSO_ENABLED=true
AUTH_SSO_NAME="Single Sign-On"
# Treat every signed-in user as admin, regardless of claims (dev/bootstrap aid;
# API keys are unaffected, nothing is written to the database).
AUTH_ALL_USERS_ADMIN=false
# Verbosity of "[auth]" log lines: debug, info, warn, error.
# "debug" also logs every granted permission check and API key authentication.
AUTH_LOG_LEVEL=info

# App URL for iCal feeds, callbacks, OpenAPI spec, widget links.
# Server-only, read at runtime.
APP_URL="http://localhost:3000"

# IANA timezone used for RRULE expansion and date formatting (e.g. "Europe/Berlin").
# Read server-side at runtime and passed to the browser via the TimezoneProvider
# in the root route - change with a container restart, no rebuild needed.
APP_TIMEZONE="Europe/Berlin"
